# ───────── App ─────────
# Public base URL (used for canonical URLs, sitemap, emails). No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ───────── Database (PostgreSQL) ─────────
# Pooled connection string (e.g. Neon/Supabase pooler) used at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/saryapure?schema=public"
# Direct (non-pooled) connection used by Prisma migrations. Same as DATABASE_URL if you have no pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/saryapure?schema=public"

# ───────── Auth ─────────
# Long random string (openssl rand -base64 48). Used to sign guest/cart cookies and hash tokens.
AUTH_SECRET="replace-with-a-long-random-string"

# ───────── First admin (used only by `npm run admin:create`) ─────────
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# ───────── Razorpay ─────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Development only: simulate Razorpay API calls. Only honoured with rzp_test_ keys and never in production.
RAZORPAY_MOCK="false"

# ───────── Email (SMTP) ─────────
# If SMTP_HOST is empty, emails are logged to the server console instead of being sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
EMAIL_FROM=""
# Where admin notifications (new orders, B2B enquiries, contact messages) are sent
ADMIN_NOTIFICATION_EMAIL=""

# ───────── Image storage ─────────
# One of: local | cloudinary | s3   (local writes to public/uploads — development only, not persistent on Vercel)
STORAGE_DRIVER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="sarya-pure"
# S3-compatible (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO...)
S3_REGION="auto"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL for uploaded objects, e.g. https://cdn.example.com
S3_PUBLIC_URL=""

# ───────── Cron ─────────
# Protects /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=""
